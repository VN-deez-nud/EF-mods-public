// ==UserScript==
// @name         Narrow.One Custom Atmosphere & Shaders
// @namespace    http://tampermonkey.net/
// @version      8.4
// @description  Custom GLSL skybox shaders, theme-matched clouds, dynamic meteor shower system on the last sky
// @description  UI selection panel (click P to activate) for Narrow.One. Alternative way to change sky is B
// @author       Ghost Rider
// @match        *://narrow.one/*
// @match        *://www.narrow.one/*
// @match        *://*.narrow.one/*
// @match        *://game-cdn.poki.com/*
// @match        *://poki.com/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    // Configuration & state management
    const VIDEO_URL = 'https://cdn.pixabay.com/video/2021/08/04/83864-584742457_tiny.mp4';

    let currentTheme = 0;
    const MAX_THEMES = 8;

    let skydomeMesh = null;
    let originalMaterial = null;
    let originalScale = null;
    let customShaderMat = null;

    let timeElapsed = 0.0;
    let textureConstructor = null;
    let shaderMaterialConstructor = null;
    let dynamicTexture = null;

    let meteorsActive = false;
    let meteorPool = [];
    const cloudCache = new Map();

    const themeNames = [
        "Native Satellite",
        "Cinematic Void",
        "Cosmic Aurora",
        "Outrun Protocol",
        "Event Horizon",
        "Solar Plasma",
        "Crimson Eclipse",
        "Abyssal Ocean",
        "Apocalyptic Endgame"
    ];

    const accentColors = ['#888', '#aaa', '#00ffcc', '#ff00aa', '#ff5500', '#ffaa00', '#ff0000', '#00aaff', '#ff2200'];

    // Video texture pipeline setup
    const videoCanvas = document.createElement('canvas');
    const canvasCtx = videoCanvas.getContext('2d', { alpha: false });
    videoCanvas.width = 1024;
    videoCanvas.height = 512;

    const bgVideo = document.createElement('video');
    bgVideo.crossOrigin = 'anonymous';
    bgVideo.loop = true;
    bgVideo.muted = true;
    bgVideo.playsInline = true;
    bgVideo.src = VIDEO_URL;

    // GLSL Shaders
    const vertexShader = `
        varying vec3 vWorldDirection;
        void main() {
            vec4 worldPos = modelMatrix * vec4(position, 1.0);
            vWorldDirection = normalize(worldPos.xyz);
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            gl_Position.z = gl_Position.w;
        }
    `;

    const fragmentShader = `
        uniform sampler2D skyTex;
        uniform int uTheme;
        uniform float uTime;
        varying vec3 vWorldDirection;

        float random(float n) { return fract(sin(n) * 43758.5453123); }

        float proceduralNoise(vec3 x) {
            vec3 p = floor(x);
            vec3 f = fract(x);
            f = f * f * (3.0 - 2.0 * f);
            float n = p.x + p.y * 57.0 + 113.0 * p.z;
            return mix(mix(mix(random(n + 0.0), random(n + 1.0), f.x),
                           mix(random(n + 57.0), random(n + 58.0), f.x), f.y),
                       mix(mix(random(n + 113.0), random(n + 114.0), f.x),
                           mix(random(n + 170.0), random(n + 171.0), f.x), f.y), f.z);
        }

        void main() {
            vec3 dir = normalize(vWorldDirection);
            vec3 finalColor = vec3(0.0);
            float denom = max(dir.y + 1.0, 0.001);
            vec2 uv = dir.xz / denom;

            if (uTheme == 1) { // Cinematic Void
                uv *= 0.8; uv.x += (uTime * 0.002); uv = fract(uv);
                vec4 texColor = texture2D(skyTex, uv);
                finalColor = pow(texColor.rgb, vec3(2.2)) * 1.6;
            }
            else if (uTheme == 2) { // Cosmic Aurora
                vec3 p = dir * 2.5 + vec3(0.0, 0.0, uTime * 0.15);
                float n = proceduralNoise(p) * 0.5 + proceduralNoise(p * 2.0) * 0.25;
                vec3 aurora = mix(vec3(0.0, 0.8, 0.6), vec3(0.5, 0.1, 0.9), dir.y + n);
                finalColor = aurora * pow(n, 1.8) * 2.5 + vec3(0.02, 0.03, 0.08);
            }
            else if (uTheme == 3) { // Outrun Cyberpunk
                uv = dir.xz / max(dir.y + 0.05, 0.001); uv.y -= uTime * 1.5;
                vec2 grid = abs(fract(uv * 4.0) - 0.5);
                float line = smoothstep(0.47, 0.5, max(grid.x, grid.y));
                float horizonGlow = exp(-dir.y * 6.0);
                finalColor = mix(vec3(0.01, 0.0, 0.03), vec3(1.0, 0.0, 0.6) * line + vec3(0.0, 0.8, 1.0) * horizonGlow, 1.0 - dir.y);
            }
            else if (uTheme == 4) { // Event Horizon
                uv = dir.xz; float r = length(uv);
                float theta = atan(uv.y, uv.x) + uTime * 0.4 - 1.5 / (r + 0.1);
                float spiral = sin(8.0 * r - uTime * 4.0 + theta * 4.0);
                vec3 coreColor = mix(vec3(0.0), vec3(1.0, 0.3, 0.0), smoothstep(0.0, 0.5, spiral));
                finalColor = coreColor * (1.0 - r) + vec3(0.05, 0.0, 0.1);
            }
            else if (uTheme == 5) { // Solar Plasma
                vec3 p = dir * 4.0 + vec3(uTime * 0.2, uTime * 0.1, 0.0);
                float n = proceduralNoise(p) * 0.5 + proceduralNoise(p * 2.0) * 0.25 + proceduralNoise(p * 4.0) * 0.125;
                vec3 heat = mix(vec3(1.0, 0.1, 0.0), vec3(1.0, 0.9, 0.2), n);
                finalColor = heat * (n * 2.5);
            }
            else if (uTheme == 6) { // Crimson Eclipse
                float sunDist = length(vec2(dir.x, dir.z));
                float sun = smoothstep(0.12, 0.13, sunDist);
                float corona = smoothstep(0.4, 0.12, sunDist) * proceduralNoise(dir * 8.0 - vec3(0.0, uTime*0.5, 0.0));
                vec3 blood = vec3(0.7, 0.02, 0.01);
                finalColor = mix(vec3(0.0), blood * corona * 3.0, sun) + vec3(0.05, 0.0, 0.02) * (1.0 - dir.y);
            }
            else if (uTheme == 7) { // Abyssal Caustics
                vec2 p = dir.xz * 3.0 / max(dir.y + 0.2, 0.1);
                p += uTime * 0.1;
                float caustic = sin(p.x * 2.0 + cos(p.y + uTime)) * cos(p.y * 2.0 + sin(p.x - uTime));
                caustic = smoothstep(0.6, 1.0, caustic);
                finalColor = vec3(0.0, 0.6, 0.8) * caustic * exp(-dir.y * 2.0) + vec3(0.01, 0.05, 0.1) * (1.0 - dir.y);
            }
            else if (uTheme == 8) { // Apocalyptic Endgame
                vec3 p = dir * 3.0 + vec3(uTime * 0.2, uTime * 0.1, 0.0);
                float n1 = proceduralNoise(p);
                float n2 = proceduralNoise(p * 2.0 - vec3(uTime * 0.3));
                float chaos = n1 * 0.5 + n2 * 0.5;

                vec3 fire = vec3(1.0, 0.2, 0.0);
                vec3 ash = vec3(0.1, 0.08, 0.08);

                float heat = smoothstep(0.5, 0.8, chaos);
                finalColor = mix(vec3(0.02, 0.0, 0.01), ash, n1);
                finalColor = mix(finalColor, fire, heat * 2.0);
                finalColor *= exp(-dir.y * 0.8);

                float strike = step(0.98, fract(sin(uTime * 15.0 + dir.x * 5.0) * 43758.5453));
                float flash = smoothstep(0.6, 1.0, proceduralNoise(vec3(uTime * 8.0))) * strike;
                finalColor += vec3(1.0, 0.9, 0.7) * flash * 3.0 * heat;
            }

            gl_FragColor = vec4(finalColor, 1.0);
        }
    `;

    // Map themes to matching cloud tints
    const themeCloudColors = {
        0: null,
        1: 0x333333,
        2: 0x6600cc,
        3: 0xff00aa,
        4: 0xff4400,
        5: 0xffbb00,
        6: 0x990000,
        7: 0x00aaff,
        8: 0x221111
    };

    function applyCloudVibe(engine, themeIndex) {
        if (!engine?.scene) return;

        engine.scene.traverse(obj => {
            if (obj.name && (obj.name.toLowerCase().includes('cloud') || obj.name.toLowerCase().includes('fog'))) {
                const materials = Array.isArray(obj.material) ? obj.material : [obj.material];

                materials.forEach(mat => {
                    if (!mat?.color) return;
                    if (!cloudCache.has(mat.uuid)) {
                        cloudCache.set(mat.uuid, mat.color.clone());
                    }

                    if (themeIndex === 0) {
                        mat.color.copy(cloudCache.get(mat.uuid));
                        mat.opacity = 1.0;
                    } else {
                        const targetHex = themeCloudColors[themeIndex];
                        if (targetHex !== null) {
                            mat.color.setHex(targetHex);
                            mat.transparent = true;
                            mat.opacity = 0.85;
                        }
                    }
                });
            }
        });
    }

    // Meteor shower generator
    function setupMeteors(engine) {
        if (meteorPool.length > 0 || !skydomeMesh) return;

        const MeshClass = skydomeMesh.constructor;
        const MaterialClass = shaderMaterialConstructor || skydomeMesh.material.constructor;
        const Vector3Class = skydomeMesh.position.constructor;

        const meteorMaterial = new MaterialClass({
            vertexShader: `
                varying vec3 vPos;
                void main() {
                    vPos = position;
                    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
                }
            `,
            fragmentShader: `
                varying vec3 vPos;
                void main() {
                    float heat = 1.0 - clamp(length(vPos) * 1.5, 0.0, 1.0);
                    vec3 color = mix(vec3(1.0, 0.1, 0.0), vec3(1.0, 1.0, 0.6), heat);
                    gl_FragColor = vec4(color, heat * 1.5);
                }
            `,
            transparent: true,
            blending: 2,
            depthWrite: false,
            side: 2
        });

        for (let i = 0; i < 35; i++) {
            const mesh = new MeshClass(skydomeMesh.geometry, meteorMaterial);
            mesh.scale.set(12.0, 12.0, 100.0);
            mesh.visible = false;
            mesh._grIgnore = true;
            engine.scene.add(mesh);

            let pos = new Vector3Class();
            let vel = new Vector3Class();

            const resetPosition = () => {
                pos.set((Math.random() - 0.5) * 600, 200 + Math.random() * 200, (Math.random() - 0.5) * 600);
                vel.set((Math.random() - 0.5) * 2.0, -(Math.random() * 4.0 + 3.0), (Math.random() - 0.5) * 2.0);
                mesh.position.copy(pos);
                mesh.lookAt(pos.clone().add(vel));
            };

            resetPosition();
            meteorPool.push({ mesh, pos, vel, resetPosition });
        }
    }

    function processMeteors() {
        meteorPool.forEach(item => {
            if (meteorsActive) {
                item.mesh.visible = true;
                item.pos.add(item.vel);
                item.mesh.position.copy(item.pos);

                if (item.pos.y < -30) item.resetPosition();
            } else {
                item.mesh.visible = false;
            }
        });
    }

    // Switch theme function
    function selectTheme(themeIndex) {
        if (!skydomeMesh || !customShaderMat || !originalMaterial || !window.gameEngineInstance) return;

        currentTheme = themeIndex;
        applyCloudVibe(window.gameEngineInstance, currentTheme);

        if (currentTheme === 0) {
            skydomeMesh.material = originalMaterial;
            skydomeMesh.scale.copy(originalScale);
            bgVideo.pause();
            meteorsActive = false;
        } else {
            skydomeMesh.material = customShaderMat;
            skydomeMesh.scale.setScalar(5000);
            customShaderMat.uniforms.uTheme.value = currentTheme;

            if (currentTheme === 1) bgVideo.play().catch(()=>{});
            else bgVideo.pause();

            meteorsActive = (currentTheme === 8);
        }

        showHUDNotification(currentTheme);
        updatePanelUI();
    }

    // HUD notifications
    function showHUDNotification(index) {
        let hudElement = document.getElementById('custom-env-hud');
        if (!hudElement) {
            hudElement = document.createElement('div');
            hudElement.id = 'custom-env-hud';
            hudElement.style.cssText = `
                position: fixed; bottom: 25px; left: 50%; transform: translateX(-50%);
                background: rgba(5, 5, 8, 0.9); padding: 8px 24px;
                border-radius: 4px; font-family: 'Courier New', Courier, monospace; font-size: 13px;
                font-weight: bold; letter-spacing: 2px; color: #fff;
                pointer-events: none; z-index: 9999999; opacity: 0;
                transition: opacity 0.3s ease; text-shadow: 0 0 5px rgba(255,255,255,0.5);
                border: 1px solid rgba(255, 255, 255, 0.1); border-bottom: 2px solid #00ffcc;
            `;
            document.body.appendChild(hudElement);
        }

        hudElement.style.borderBottom = `2px solid ${accentColors[index]}`;

        if (index >= 8) {
            hudElement.style.boxShadow = "0 0 20px rgba(255,0,0,0.6)";
            hudElement.style.textShadow = "0 0 10px rgba(255,0,0,0.8)";
        } else {
            hudElement.style.boxShadow = "none";
            hudElement.style.textShadow = "0 0 5px rgba(255,255,255,0.5)";
        }

        hudElement.innerText = `ENVIRONMENT: ${themeNames[index].toUpperCase()}`;
        hudElement.style.opacity = '1';

        if (hudElement.hideTimer) clearTimeout(hudElement.hideTimer);
        hudElement.hideTimer = setTimeout(() => { hudElement.style.opacity = '0'; }, 2000);
    }

    // Interactive Selection Panel UI (Positioned on Left Screen)
    function buildSelectionPanel() {
        if (document.getElementById('custom-env-panel')) return;

        const panel = document.createElement('div');
        panel.id = 'custom-env-panel';
        panel.style.cssText = `
            position: fixed; top: 50%; left: 20px; transform: translateY(-50%);
            width: 320px; background: rgba(10, 10, 16, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.8), 0 0 15px rgba(0, 255, 204, 0.2);
            font-family: 'Courier New', Courier, monospace; color: #fff;
            z-index: 99999999; display: none; flex-direction: column; padding: 16px;
            backdrop-filter: blur(10px);
        `;

        const title = document.createElement('div');
        title.style.cssText = `
            font-size: 14px; font-weight: bold; letter-spacing: 2px;
            text-align: center; margin-bottom: 12px; color: #00ffcc;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 8px;
            display: flex; justify-content: space-between; align-items: center;
        `;
        title.innerHTML = `<span>ATMOSPHERE SELECTOR</span><span style="font-size: 10px; color: #666;">[ESC/P]</span>`;
        panel.appendChild(title);

        const listContainer = document.createElement('div');
        listContainer.id = 'custom-env-list';
        listContainer.style.cssText = `display: flex; flex-direction: column; gap: 6px;`;

        themeNames.forEach((name, idx) => {
            const btn = document.createElement('button');
            btn.className = 'custom-theme-btn';
            btn.dataset.index = idx;
            btn.style.cssText = `
                background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08);
                color: #ccc; padding: 8px 12px; border-radius: 4px; font-family: inherit;
                font-size: 12px; text-align: left; cursor: pointer; transition: all 0.2s ease;
                display: flex; align-items: center; justify-content: space-between; outline: none;
            `;

            btn.addEventListener('mouseover', () => {
                btn.style.background = 'rgba(255, 255, 255, 0.15)';
                btn.style.borderColor = accentColors[idx];
                btn.style.color = '#fff';
            });

            btn.addEventListener('mouseout', () => {
                if (parseInt(btn.dataset.index) !== currentTheme) {
                    btn.style.background = 'rgba(255, 255, 255, 0.05)';
                    btn.style.borderColor = 'rgba(255, 255, 255, 0.08)';
                    btn.style.color = '#ccc';
                } else {
                    btn.style.background = 'rgba(0, 255, 204, 0.15)';
                    btn.style.borderColor = accentColors[idx];
                    btn.style.color = '#00ffcc';
                }
            });

            btn.addEventListener('click', () => {
                selectTheme(idx);
            });

            listContainer.appendChild(btn);
        });

        panel.appendChild(listContainer);
        document.body.appendChild(panel);
    }

    function updatePanelUI() {
        const buttons = document.querySelectorAll('.custom-theme-btn');
        buttons.forEach(btn => {
            const idx = parseInt(btn.dataset.index);
            const isActive = idx === currentTheme;

            btn.innerHTML = `
                <span>${idx}. ${themeNames[idx]}</span>
                <span style="height: 8px; width: 8px; border-radius: 50%; background: ${isActive ? accentColors[idx] : '#333'}; display: inline-block;"></span>
            `;

            if (isActive) {
                btn.style.background = 'rgba(0, 255, 204, 0.15)';
                btn.style.borderColor = accentColors[idx];
                btn.style.color = '#00ffcc';
            } else {
                btn.style.background = 'rgba(255, 255, 255, 0.05)';
                btn.style.borderColor = 'rgba(255, 255, 255, 0.08)';
                btn.style.color = '#ccc';
            }
        });
    }

    function togglePanel() {
        buildSelectionPanel();
        const panel = document.getElementById('custom-env-panel');
        if (!panel) return;

        if (panel.style.display === 'none' || panel.style.display === '') {
            updatePanelUI();
            panel.style.display = 'flex';
        } else {
            panel.style.display = 'none';
        }
    }

    // Engine hook implementation
    function hookSkydome(engineInstance, skydome) {
        if (skydome._hooked) return;
        skydome._hooked = true;

        skydomeMesh = skydome;
        originalMaterial = skydome.material;
        originalScale = skydome.scale.clone();

        // Discover materials & textures across scene graph
        engineInstance.scene.traverse(obj => {
            const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
            mats.forEach(mat => {
                if (!mat) return;
                if (mat.type === 'ShaderMaterial' || mat.vertexShader) {
                    shaderMaterialConstructor = mat.constructor;
                }
                if (mat.uniforms) {
                    Object.values(mat.uniforms).forEach(u => {
                        if (u?.value?.isTexture && !textureConstructor) {
                            textureConstructor = u.value.constructor;
                        }
                    });
                }
            });
        });

        const MaterialClass = shaderMaterialConstructor || skydome.material.constructor;

        customShaderMat = new MaterialClass({
            vertexShader,
            fragmentShader,
            uniforms: {
                skyTex: { value: null },
                uTheme: { value: 0 },
                uTime:  { value: 0.0 }
            },
            side: 1, // THREE.BackSide
            depthWrite: false,
        });

        if (textureConstructor) {
            dynamicTexture = new textureConstructor(videoCanvas);
            customShaderMat.uniforms.skyTex.value = dynamicTexture;
        }

        setupMeteors(engineInstance);
        buildSelectionPanel();

        const renderLoop = () => {
            if (currentTheme > 0 && customShaderMat) {
                timeElapsed += 0.01;
                customShaderMat.uniforms.uTime.value = timeElapsed;

                if (currentTheme === 1 && bgVideo.readyState >= 2) {
                    canvasCtx.drawImage(bgVideo, 0, 0, videoCanvas.width, videoCanvas.height);
                    if (dynamicTexture) dynamicTexture.needsUpdate = true;
                }
            }
            processMeteors();
            requestAnimationFrame(renderLoop);
        };
        renderLoop();
    }

    // Hotkey listeners (B = Next theme, P = Toggle selection panel)
    window.addEventListener('keydown', (e) => {
        if (document.activeElement.tagName === "INPUT" || document.activeElement.tagName === "TEXTAREA") return;

        if (e.key === 'b' || e.key === 'B') {
            let nextTheme = currentTheme + 1;
            if (nextTheme > MAX_THEMES) nextTheme = 0;
            selectTheme(nextTheme);
        }

        if (e.key === 'p' || e.key === 'P') {
            togglePanel();
        }

        if (e.key === 'Escape') {
            const panel = document.getElementById('custom-env-panel');
            if (panel) panel.style.display = 'none';
        }
    });

    // WebSocket interceptor to grab engine instance
    const OriginalWebSocket = window.WebSocket;
    window.WebSocket = class extends OriginalWebSocket {
        constructor(...args) {
            super(...args);
            this.addEventListener('open', () => {
                setTimeout(() => {
                    if (window.gameEngineInstance) return;
                    try {
                        const payload = JSON.stringify({ id: "cap", c: "window.gameEngineInstance = main;" });
                        const bytes = new TextEncoder().encode(payload);
                        const buffer = new ArrayBuffer(8 + bytes.length);
                        const view32 = new Uint32Array(buffer, 0, 2);
                        view32[0] = 55; view32[1] = bytes.length;
                        new Uint8Array(buffer).set(bytes, 8);
                        this.dispatchEvent(new MessageEvent('message', { data: buffer }));
                    } catch (err) {}
                }, 500);
            });
        }
    };

    function scanEngine(engine) {
        if (!engine?.scene || engine.scene._locked) return;
        engine.scene._locked = true;

        engine.scene.traverse(obj => {
            if (obj.name === 'skydome') hookSkydome(engine, obj);
        });

        const originalAdd = engine.scene.add.bind(engine.scene);
        engine.scene.add = function (...args) {
            originalAdd(...args);
            for (const item of args) {
                if (item?._grIgnore) continue;
                if (item?.name === 'skydome') {
                    hookSkydome(engine, item);
                }
                if (item?.name && (item.name.toLowerCase().includes('cloud') || item.name.toLowerCase().includes('fog'))) {
                    applyCloudVibe(engine, currentTheme);
                }
            }
        };
    }

    let globalEngineRef = null;
    Object.defineProperty(window, 'gameEngineInstance', {
        get: () => globalEngineRef,
        set: (v) => { globalEngineRef = v; if (v) scanEngine(v); },
        configurable: true
    });

    // Fallback engine scanner
    setInterval(() => {
        if (!window.gameEngineInstance) {
            for (const k in window) {
                if (window[k]?.scene?.isScene) {
                    window.gameEngineInstance = window[k];
                    break;
                }
            }
        } else if (window.gameEngineInstance?.scene) {
            scanEngine(window.gameEngineInstance);
        }
    }, 1000);

})();
